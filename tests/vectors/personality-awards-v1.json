     ["starter", "start", "Sent the first message of the day 30 times."],
     ["interrogator", "quiz", "Asked 25 questions."],
     ["early_bird", "dawn", "40 messages before 9 AM."],
     ["closer", "last", "Had the last word on 20 days."],
     ["link_dropper", "links", "Shared 12 links."]]},

